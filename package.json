{
  "name": "mutewatch",
  "version": "1.0.0",
  "description": "Discord bot that automatically informs users when they are timed out.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "prisma generate && tsc",
    "start": "prisma db push && node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init"
  },
  "dependencies": {
    "@prisma/client": "^5.15.0",
    "discord.js": "^14.15.3",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "prisma": "^5.15.0",
    "tsx": "^4.15.5",
    "typescript": "^5.4.5"
  }
}
